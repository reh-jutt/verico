# ---------------------------------------------------------------------------
# Verico — environment variables
# Copy this file to `.env.local` and fill in real values before running.
# `.env.local` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that contact-form submissions are delivered to.
CONTACT_EMAIL=hello@verico.dev

# Public WhatsApp number for the wa.me deep link (digits only, incl. country code).
# Exposed to the browser, so it must be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_WHATSAPP_NUMBER=92XXXXXXXXXX
